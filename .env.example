# Session Q&A — environment variables (Vite reads VITE_* at build time)
#
# Copy this file to `.env.local` and fill in real values.
# Everything here is safe to expose in the client bundle: the Firebase web
# config and the App Check *site* key are public by design. Server secrets
# (service accounts, Slack tokens) never belong in a VITE_* variable.
#
# If VITE_FIREBASE_* are omitted, src/config/firebase.js falls back to the
# bundled sample project so the app still builds. Demo mode works with no
# config at all.

# ── Firebase web config ──────────────────────────────────────────────────────
# Firebase Console → Project settings → General → "Your apps" (web app).
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── Firebase App Check (reCAPTCHA v3) ────────────────────────────────────────
# Firebase Console → App Check → register the web app with reCAPTCHA v3, then
# paste the reCAPTCHA v3 *site* key here to override the default.
#
# Leaving this unset is fine: src/config/firebase.js carries the project's site
# key as a committed default, so production builds from a clean checkout still
# initialise App Check. Only set this to point a build at a different key.
VITE_APPCHECK_SITE_KEY=

# Optional: set to any value to force the App Check debug provider in local dev
# (Firebase Console → App Check → Manage debug tokens to register the printed
# token). Never set this in production.
# VITE_APPCHECK_DEBUG=1
